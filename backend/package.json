{
  "name": "careflow-backend",
  "version": "1.0.0",
  "description": "CareFlow Backend API & Real-time Server",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
